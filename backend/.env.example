# Copy to .env and fill in. Never commit .env.
# Docker Postgres is exposed on host port 5433 (see docker-compose.yml).
DATABASE_URL=postgresql+psycopg://radio:radio@localhost:5433/radio

# Which LLM implementation to use. Currently supported: gemini
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# The client times out after 15 s. gemini-3.1-flash-lite answers in about 3 s;
# gemini-3.8-flash was too slow in tests and made the DJ fall back to the template intro.
GEMINI_MODEL=gemini-3.1-flash-lite
# Tried in order when the main model fails, e.g. with 503 "high demand". Comma-separated.
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.8-flash

# Jamendo developer key (music catalog). Get one at https://devportal.jamendo.com
JAMENDO_CLIENT_ID=

# Login cookie is sent only over HTTPS when true. Keep false for local http, true in production.
COOKIE_SECURE=false

# Speech (TTS) service, started separately (speech/service/README.md).
# The browser never calls it: announcement audio is served by the backend at /api/speech/audio/.
SPEECH_SERVICE_URL=http://localhost:8001

# Seconds the player may wait for a DJ announcement that is still being voiced (0 = never wait,
# play the song). For a demo where songs are skipped quickly, 30 keeps the DJ on air.
PLANNER_ANNOUNCEMENT_WAIT_S=0
# Longest time for writing and voicing one announcement. Orpheus on an 8 GB laptop GPU can need
# 1-2 minutes per line; 240 suits a demo on that laptop.
PLANNER_ANNOUNCEMENT_TIMEOUT_S=90

# Address phones use for the request page (QR code on the studio screen). Empty: this
# computer's network address on port 5173 is used, e.g. http://192.168.137.1:5173
PUBLIC_WEB_URL=
