# Copy to .env and fill in. Never commit .env.
# Docker Postgres is exposed on host port 5433 (see docker-compose.yml).
DATABASE_URL=postgresql+psycopg://radio:radio@localhost:5433/radio

# Which LLM implementation to use. Currently supported: gemini
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
