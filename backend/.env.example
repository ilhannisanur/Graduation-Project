# Copy to .env and fill in. Never commit .env.
# Docker Postgres is exposed on host port 5433 (see docker-compose.yml).
DATABASE_URL=postgresql+psycopg://radio:radio@localhost:5433/radio

# Which LLM implementation to use. Currently supported: gemini
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# The client times out after 15 s. gemini-3.1-flash-lite answers in about 3 s;
# gemini-3.8-flash was too slow in tests and made the DJ fall back to the template intro.
GEMINI_MODEL=gemini-3.1-flash-lite

# Jamendo developer key (music catalog). Get one at https://devportal.jamendo.com
JAMENDO_CLIENT_ID=

# Login cookie is sent only over HTTPS when true. Keep false for local http, true in production.
COOKIE_SECURE=false

# Speech (TTS) service, started separately (speech/service/README.md).
# The browser never calls it: announcement audio is served by the backend at /api/speech/audio/.
SPEECH_SERVICE_URL=http://localhost:8001
