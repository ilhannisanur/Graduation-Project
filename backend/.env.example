# Copy to .env and fill in. Never commit .env.
# Docker Postgres is exposed on host port 5433 (see docker-compose.yml).
DATABASE_URL=postgresql+psycopg://radio:radio@localhost:5433/radio

# Which LLM implementation to use. Currently supported: gemini
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Jamendo developer key (music catalog). Get one at https://devportal.jamendo.com
JAMENDO_CLIENT_ID=

# Login cookie is sent only over HTTPS when true. Keep false for local http, true in production.
COOKIE_SECURE=false
