# Copy to .env and change if needed. Every value has a sensible default.

# auto = Orpheus on a CUDA GPU, otherwise Kokoro on the CPU (decision of #4)
TTS_ENGINE=auto
# used when the main engine is missing or fails; always runs on the CPU ("" = no fallback)
TTS_FALLBACK_ENGINE=kokoro
# auto, cpu or cuda
TTS_DEVICE=auto
# engine options as key=value pairs, e.g. voice=af_heart
TTS_ENGINE_OPTIONS=
TTS_FALLBACK_OPTIONS=

# where generated audio is cached (relative to speech/service)
SPEECH_AUDIO_DIR=data/audio
SPEECH_SAMPLE_RATE=24000
SPEECH_MAX_TEXT_CHARS=1000
SPEECH_LOAD_ON_STARTUP=true
